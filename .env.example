# ── Secrets (change these in production) ─────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_key_change_me
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_me
INTERNAL_SERVICE_SECRET=internal_service_secret_change_me

# ── API Gateway (Port 3000) ───────────────────────────────────────────────────
GATEWAY_PORT=3000
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
DASHBOARD_SERVICE_URL=http://localhost:3003
FILE_SERVICE_URL=http://localhost:3004

# ── Auth Service (Port 3001) ──────────────────────────────────────────────────
AUTH_SERVICE_PORT=3001
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres

# ── User Service (Port 3002) ──────────────────────────────────────────────────
USER_SERVICE_PORT=3002
USER_DB_HOST=localhost
USER_DB_PORT=5432
USER_DB_NAME=user_db
USER_DB_USER=postgres
USER_DB_PASSWORD=postgres

# ── Dashboard Service (Port 3003) ─────────────────────────────────────────────
DASHBOARD_SERVICE_PORT=3003
DASHBOARD_DB_HOST=localhost
DASHBOARD_DB_PORT=5432
DASHBOARD_DB_NAME=dashboard_db
DASHBOARD_DB_USER=postgres
DASHBOARD_DB_PASSWORD=postgres

# ── File Service (Port 3004) ──────────────────────────────────────────────────
FILE_SERVICE_PORT=3004
FILE_DB_HOST=localhost
FILE_DB_PORT=5432
FILE_DB_NAME=file_db
FILE_DB_USER=postgres
FILE_DB_PASSWORD=postgres
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE_BYTES=10485760

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
